dh_install
# Wallpaper image: KDE image-wallpaper layout, resolution-named file.
install -D -m 0644 assets/wallpapers/cham3_minimal_charcoal.png \
    debian/cham3-desktop/usr/share/wallpapers/Cham3/contents/images/3840x2160.png
# Layout template org.cham3.panel: the panel script keeps its repo name and
# is installed under the name Plasma requires (contents/layout.js).
install -D -m 0644 desktop/plasma/layout-templates/org.cham3.panel/metadata.json \
    debian/cham3-desktop/usr/share/plasma/layout-templates/org.cham3.panel/metadata.json
install -D -m 0644 desktop/plasma/layout/cham3_panel_layout.js \
    debian/cham3-desktop/usr/share/plasma/layout-templates/org.cham3.panel/contents/layout.js
# System-wide defaults (lowest precedence, overridden by user config):
# make the cham3 look-and-feel the default for new profiles and carry the
# color scheme values, because KDE reads colors from kdeglobals.
install -d debian/cham3-desktop/etc/xdg
sed -e 's/^contrast=4$/contrast=4\nLookAndFeelPackage=org.cham3.desktop\nwidgetStyle=Breeze/' \
    -e '/^\[Cham3Accents\]$/,$d' \
    desktop/plasma/color-schemes/Cham3Dark.colors > debian/cham3-desktop/etc/xdg/kdeglobals
printf '\n[Icons]\nTheme=breeze-dark\n' >> debian/cham3-desktop/etc/xdg/kdeglobals
printf '[Theme]\nname=breeze-dark\n' > debian/cham3-desktop/etc/xdg/plasmarc

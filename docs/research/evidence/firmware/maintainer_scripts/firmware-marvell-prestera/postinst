#!/bin/sh

set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
	for f in mrvl/prestera/mvsw_prestera_fw-v2.0.img; do
		dpkg-divert --package firmware-marvell-prestera --no-rename --quiet \
			--divert "/lib/firmware/$f.usr-is-merged" \
			--remove "/lib/firmware/$f"
	done
fi



exit 0

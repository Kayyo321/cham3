#!/bin/sh
# Purpose: live-build configuration for the cham3 M1 desktop image.
# Invoked by "lb config". Written against live-build 20250505+deb13u1 (Debian 13).
# Limits: M1 visual and package foundation. Debian 13 amd64 with KDE Plasma 6 on
# Wayland, cham3 desktop defaults, an installable image and the curated Debian
# application suite (package cham3-full). No cham3 security backend exists in M1:
# the panel reports those services as unavailable, so the result is a
# development artifact, not a hardened distribution and not a release.
set -eu

# Mirrors: as in M0, the plain-HTTP official Debian mirrors are the Debian default
# and are kept on purpose. APT verifies the signed InRelease files with
# debian-archive-keyring and authentication is not disabled (--apt-secure true).
# Archive areas: contrib and non-free are needed for torbrowser-launcher (contrib)
# and nikto (non-free); non-free-firmware serves --firmware-chroot/--firmware-binary
# so real hardware and VM graphics/network work on the live and installed system.
#
# --apt-recommends false (decision, differs from stock KDE installs): recommends
# would roughly double the package count and pull in services this image must not
# ship by default, for example kdeconnect (a LAN-listening daemon) and VLC
# components. The Plasma runtime pieces that are only "Recommends" upstream
# (kio-extras, kscreen, powerdevil, the xdg portal, SDDM theme, fonts, ...) are
# listed as hard Depends of cham3-desktop instead, so the dependency closure is
# explicit and reviewable.
#
# Session: SDDM comes from cham3-desktop. The live user is auto-logged-in by
# live-config; the config component 0086-cham3-sddm-wayland makes that
# autologin start the Plasma Wayland session (plasma.desktop).
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer live \
    --binary-image iso-hybrid \
    --bootloaders syslinux,grub-efi \
    --firmware-chroot true \
    --firmware-binary true \
    --security true \
    --updates true \
    --apt-secure true \
    --apt-recommends false \
    --cache false \
    --mirror-bootstrap http://deb.debian.org/debian/ \
    --mirror-chroot http://deb.debian.org/debian/ \
    --mirror-chroot-security http://security.debian.org/ \
    --mirror-binary http://deb.debian.org/debian/ \
    --mirror-binary-security http://security.debian.org/ \
    --bootappend-live "boot=live components console=tty0 console=ttyS0,115200n8" \
    --image-name cham3-m1-desktop \
    --iso-application "cham3 M1 desktop image" \
    --iso-publisher "cham3 project; M1 development build, not a release" \
    --iso-preparer "cham3 M1 build via live-build" \
    --iso-volume "CHAM3_M1_DESKTOP" \
    "${@}"

# cham3 dark color scheme (M1 visual foundation).
# Group and key names are the KDE color-scheme file format (external boundary).
# Structure follows KDE's BreezeDark.colors (LGPL-2.0-or-later); the values
# below are cham3's. Selection and focus use a neutral accent on purpose so
# that Rose, Purple and White keep their single meaning (Direct, Tor, Offline).

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0


#!/bin/sh
# cham3-desktop maintainer script (configure and triggered).
#
# Sole purpose: keep Wireshark's capture helper, /usr/bin/dumpcap, failing
# closed. Debian's wireshark-common postinst gives non-root users packet capture
# through the "wireshark" group plus file capabilities, but when setcap is
# missing or fails it falls back to a set-user-id root dumpcap. cham3 does not
# accept that fallback, and dumpcap is not left set-user-id on any path:
#
#   1. A dpkg-statoverride (root root 0754) is pinned on dumpcap. While an
#      override exists, wireshark-common's postinst changes nothing on the file
#      (it only lists the override), so its set-user-id fallback cannot run
#      during install, upgrade or dpkg-reconfigure, whatever the order in which
#      dpkg configures cham3-desktop and wireshark-common. dpkg applies the
#      override on every unpack, so a new dumpcap is never set-user-id either.
#      The override uses group root so that it never names the wireshark group:
#      wireshark-common deletes that group when it is purged, and dpkg aborts
#      when an override names an unknown group.
#   2. This script runs when cham3-desktop is configured and, through the file
#      trigger in debian/triggers, whenever a package installs, upgrades or
#      removes /usr/bin/dumpcap. If dumpcap is installed it
#        - removes the set-user-id and set-group-id bits,
#        - makes it root:wireshark, mode 0754 (no access for others), creating
#          the system group when needed, and
#        - sets only cap_net_admin,cap_net_raw=eip on it.
#      If the capabilities cannot be set, dumpcap is left with no set-id bit and
#      no file capabilities: capture is unavailable (fail closed), never root.
#
# It does nothing to dumpcap when it is not installed, and it never adds a user
# to the "wireshark" group: membership is a deliberate per-user administrative
# step.
set -e

dumpcap_default_path=/usr/bin/dumpcap
capture_group=wireshark
capture_caps=cap_net_admin,cap_net_raw=eip
# The dpkg-statoverride pin: owner, group, mode (as dpkg-statoverride lists it).
pin_owner=root
pin_group=root
pin_mode_argument=0754
pin_mode_listed=754

report() {
    printf 'cham3-desktop: %s\n' "$1" >&2
}

has_set_id_bit() {
    [ -u "$1" ] || [ -g "$1" ]
}

has_file_capabilities() {
    command -v getcap > /dev/null 2>&1 || return 1
    [ -n "$(getcap -- "$1" 2> /dev/null)" ]
}

# True when the file is owned by root, group "wireshark", with no access for
# others: the only configuration in which file capabilities may be set, because
# capabilities on a world-executable dumpcap would give every user capture.
is_group_restricted() {
    restricted_stat=$(stat -c '%u %G %a' -- "$1") || return 1
    restricted_owner=${restricted_stat%% *}
    restricted_rest=${restricted_stat#* }
    restricted_group=${restricted_rest%% *}
    restricted_mode=${restricted_rest#* }
    restricted_others=${restricted_mode#"${restricted_mode%?}"}
    [ "${restricted_owner}" = "0" ] || return 1
    [ "${restricted_group}" = "${capture_group}" ] || return 1
    case "${restricted_others}" in
        1 | 3 | 5 | 7) return 1 ;;
    esac
    return 0
}

ensure_capture_group() {
    if getent group "${capture_group}" > /dev/null 2>&1; then
        return 0
    fi
    if command -v addgroup > /dev/null 2>&1; then
        addgroup --system --quiet "${capture_group}" || true
    elif command -v groupadd > /dev/null 2>&1; then
        groupadd --system "${capture_group}" || true
    fi
    getent group "${capture_group}" > /dev/null 2>&1
}

# Pin the dpkg-statoverride and set foreign_override=yes when the administrator
# already has a different override for the file, which is then left alone.
pin_dumpcap_override() {
    foreign_override=no
    current_override=$(dpkg-statoverride --list "$1" 2> /dev/null) || current_override=
    if [ -z "${current_override}" ]; then
        if ! dpkg-statoverride --add "${pin_owner}" "${pin_group}" "${pin_mode_argument}" "$1"; then
            report "WARNING: could not add the dpkg-statoverride for $1; the set-user-id fallback of wireshark-common is not blocked"
        fi
    elif [ "${current_override}" != "${pin_owner} ${pin_group} ${pin_mode_listed} $1" ]; then
        foreign_override=yes
        report "dpkg-statoverride for $1 was set by the administrator (${current_override}); ownership and mode are left unchanged"
    fi
}

enforce_dumpcap_policy() {
    program=$(dpkg-divert --truename "${dumpcap_default_path}" 2> /dev/null) || program=${dumpcap_default_path}
    pin_dumpcap_override "${program}"

    program=$(readlink -f -- "${program}" 2> /dev/null) || program=${dumpcap_default_path}
    if [ ! -f "${program}" ]; then
        return 0
    fi

    # Remove the set-id bits first, so that a later failure cannot leave them.
    chmod u-s,g-s -- "${program}"

    if [ "${foreign_override}" = "no" ]; then
        if ensure_capture_group; then
            chown "root:${capture_group}" -- "${program}"
            chmod u=rwx,g=rx,o=r -- "${program}"
        else
            report "could not create the system group ${capture_group}; ${program} is left without file capabilities"
        fi
    fi

    # File capabilities, only on the group-restricted file. chown removed any
    # earlier capabilities, so they are always set again here.
    capabilities_set=no
    if is_group_restricted "${program}" && command -v setcap > /dev/null 2>&1; then
        if setcap "${capture_caps}" "${program}"; then
            capabilities_set=yes
        fi
    fi

    if [ "${capabilities_set}" = "no" ]; then
        # Fail closed: no capabilities and no set-id bit, never a root fallback.
        if command -v setcap > /dev/null 2>&1; then
            setcap -r "${program}" > /dev/null 2>&1 || true
        fi
        chmod u-s,g-s -- "${program}"
        report "WARNING: file capabilities were not set on ${program}."
        report "Packet capture by non-root users is unavailable (fail closed); the set-user-id fallback is not used."
        report "Fix the cause (capability support on the file system) and run: dpkg-reconfigure cham3-desktop"
        if has_file_capabilities "${program}"; then
            report "ERROR: ${program} still has file capabilities but is not group-restricted; refusing to continue."
            return 1
        fi
    fi

    if has_set_id_bit "${program}"; then
        report "ERROR: ${program} is still set-user-id or set-group-id; refusing to continue."
        return 1
    fi
    return 0
}

case "$1" in
    configure | triggered)
        enforce_dumpcap_policy
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

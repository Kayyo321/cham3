#!/bin/sh
# cham3-desktop maintainer script (configure and triggered).
#
# Sole purpose: keep Wireshark's capture helper, /usr/bin/dumpcap, failing
# closed. Debian's wireshark-common postinst gives non-root users packet capture
# through the "wireshark" group plus file capabilities, but when setcap is
# missing or fails it falls back to a set-user-id root dumpcap. cham3 does not
# accept that fallback, and dumpcap is not left set-user-id on any path:
#
#   1. A dpkg-statoverride (root root 0750) is pinned on dumpcap. The preinst
#      registers it when cham3-desktop is unpacked, before dpkg can configure
#      wireshark-common in the same run, and this script checks it again. While
#      an override exists, wireshark-common's postinst changes nothing on the
#      file (it only lists the override), so its set-user-id fallback cannot run
#      on a first installation in either configuration order, on an upgrade, on
#      dpkg-reconfigure wireshark-common, or when wireshark-common is installed
#      after cham3-desktop. dpkg applies the override on every unpack, so a new
#      dumpcap is never set-user-id either. In the image the debconf answer
#      wireshark-common/install-setuid is preseeded false as well, so
#      wireshark-common does not choose the set-user-id layout at all.
#      The override uses group root so that it never names the wireshark group:
#      wireshark-common deletes that group when it is purged, and dpkg aborts
#      when an override names an unknown group. If the override cannot be
#      registered, or an existing override gives dumpcap a set-id mode, this
#      script clears the set-id bits and then fails: the package is reported as
#      not configured instead of reporting a policy that is not in place.
#   2. This script runs when cham3-desktop is configured and, through the file
#      trigger in debian/triggers, whenever a package installs, upgrades or
#      removes /usr/bin/dumpcap. If dumpcap is installed it
#        - removes the set-user-id and set-group-id bits,
#        - makes it root:wireshark, mode 0750 (no access for others), creating
#          the system group when needed, and
#        - sets only cap_net_admin,cap_net_raw=eip on it.
#      If the capabilities cannot be set, dumpcap is left with no set-id bit and
#      no file capabilities: capture is unavailable (fail closed), never root.
#
# When dumpcap is not installed it changes no file (it only checks the
# override, which dpkg applies if wireshark-common is installed later). It never
# adds a user to the "wireshark" group: membership is a deliberate per-user
# administrative step.
set -e

dumpcap_default_path=/usr/bin/dumpcap
capture_group=wireshark
capture_caps=cap_net_admin,cap_net_raw=eip
# The dpkg-statoverride pin: owner, group, mode (as dpkg-statoverride lists it).
pin_owner=root
pin_group=root
pin_mode_argument=0750
pin_mode_listed=750

report() {
    printf 'cham3-desktop: %s\n' "$1" >&2
}

has_set_id_bit() {
    [ -u "$1" ] || [ -g "$1" ]
}

has_file_capabilities() {
    command -v getcap > /dev/null 2>&1 || return 1
    [ -n "$(getcap -- "$1" 2> /dev/null)" ]
}

# True when the file is owned by root, group "wireshark", with no access for
# others: the only configuration in which file capabilities may be set, because
# capabilities on a world-executable dumpcap would give every user capture.
is_group_restricted() {
    restricted_stat=$(stat -c '%u %G %a' -- "$1") || return 1
    restricted_owner=${restricted_stat%% *}
    restricted_rest=${restricted_stat#* }
    restricted_group=${restricted_rest%% *}
    restricted_mode=${restricted_rest#* }
    restricted_others=${restricted_mode#"${restricted_mode%?}"}
    [ "${restricted_owner}" = "0" ] || return 1
    [ "${restricted_group}" = "${capture_group}" ] || return 1
    case "${restricted_others}" in
        1 | 3 | 5 | 7) return 1 ;;
    esac
    return 0
}

ensure_capture_group() {
    if getent group "${capture_group}" > /dev/null 2>&1; then
        return 0
    fi
    if command -v addgroup > /dev/null 2>&1; then
        addgroup --system --quiet "${capture_group}" || true
    elif command -v groupadd > /dev/null 2>&1; then
        groupadd --system "${capture_group}" || true
    fi
    getent group "${capture_group}" > /dev/null 2>&1
}

# True when a dpkg-statoverride listing ("owner group mode path") has a
# set-user-id or set-group-id mode.
override_has_set_id_mode() {
    listed_mode=$(printf '%s\n' "$1" | awk '{ print $3 }')
    case "${listed_mode}" in
        [2-7][0-7][0-7][0-7]) return 0 ;;
    esac
    return 1
}

# Make sure the dpkg-statoverride is in place (normally the preinst registered
# it). Sets foreign_override=yes when the administrator already has a different
# override without a set-id mode, which is then left alone. Returns 1 when the
# override cannot be registered or an existing override has a set-id mode.
pin_dumpcap_override() {
    foreign_override=no
    current_override=$(dpkg-statoverride --list "$1" 2> /dev/null) || current_override=
    if [ -z "${current_override}" ]; then
        if ! dpkg-statoverride --add "${pin_owner}" "${pin_group}" "${pin_mode_argument}" "$1"; then
            report "ERROR: could not register the dpkg-statoverride for $1; the set-user-id fallback of wireshark-common would not be blocked"
            return 1
        fi
        current_override=$(dpkg-statoverride --list "$1" 2> /dev/null) || current_override=
        if [ "${current_override}" != "${pin_owner} ${pin_group} ${pin_mode_listed} $1" ]; then
            report "ERROR: the dpkg-statoverride for $1 is not in place after registering it (found '${current_override}')"
            return 1
        fi
    elif override_has_set_id_mode "${current_override}"; then
        report "ERROR: an existing dpkg-statoverride gives $1 a set-id mode (${current_override}); cham3 does not allow a set-user-id or set-group-id dumpcap."
        report "Remove it (dpkg-statoverride --remove $1) and run: dpkg-reconfigure cham3-desktop"
        return 1
    elif [ "${current_override}" != "${pin_owner} ${pin_group} ${pin_mode_listed} $1" ]; then
        foreign_override=yes
        report "dpkg-statoverride for $1 was set by the administrator (${current_override}); ownership and mode are left unchanged"
    fi
    return 0
}

enforce_dumpcap_policy() {
    override_path=$(dpkg-divert --truename "${dumpcap_default_path}" 2> /dev/null) || override_path=${dumpcap_default_path}
    program=$(readlink -f -- "${override_path}" 2> /dev/null) || program=${override_path}

    # Remove the set-id bits first, so that no later failure can leave them.
    if [ -f "${program}" ]; then
        chmod u-s,g-s -- "${program}"
    fi

    if ! pin_dumpcap_override "${override_path}"; then
        report "Refusing to continue: the no-set-user-id policy for dumpcap is not in place."
        if [ -f "${program}" ] && has_set_id_bit "${program}"; then
            report "ERROR: ${program} is still set-user-id or set-group-id."
        fi
        return 1
    fi

    if [ ! -f "${program}" ]; then
        return 0
    fi

    if [ "${foreign_override}" = "no" ]; then
        if ensure_capture_group; then
            chown "root:${capture_group}" -- "${program}"
            chmod u=rwx,g=rx,o= -- "${program}"
        else
            report "could not create the system group ${capture_group}; ${program} is left without file capabilities"
        fi
    fi

    # File capabilities, only on the group-restricted file. chown removed any
    # earlier capabilities, so they are always set again here.
    capabilities_set=no
    if is_group_restricted "${program}" && command -v setcap > /dev/null 2>&1; then
        if setcap "${capture_caps}" "${program}"; then
            capabilities_set=yes
        fi
    fi

    if [ "${capabilities_set}" = "no" ]; then
        # Fail closed: no capabilities and no set-id bit, never a root fallback.
        if command -v setcap > /dev/null 2>&1; then
            setcap -r "${program}" > /dev/null 2>&1 || true
        fi
        chmod u-s,g-s -- "${program}"
        report "WARNING: file capabilities were not set on ${program}."
        report "Packet capture by non-root users is unavailable (fail closed); the set-user-id fallback is not used."
        report "Fix the cause (capability support on the file system) and run: dpkg-reconfigure cham3-desktop"
        if has_file_capabilities "${program}"; then
            if is_group_restricted "${program}"; then
                report "file capabilities that were already on the group-restricted ${program} could not be removed and are left as they are"
            else
                report "ERROR: ${program} has file capabilities that could not be removed and is not group-restricted; refusing to continue."
                return 1
            fi
        fi
    fi

    if has_set_id_bit "${program}"; then
        report "ERROR: ${program} is still set-user-id or set-group-id; refusing to continue."
        return 1
    fi
    return 0
}

case "$1" in
    configure | triggered)
        enforce_dumpcap_policy
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

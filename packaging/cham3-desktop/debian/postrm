#!/bin/sh
# cham3-desktop postrm: on purge only, drop the dpkg-statoverride that
# debian/preinst registers (and debian/postinst checks) on /usr/bin/dumpcap, and
# only when it is exactly the one this package adds. An override set by the administrator is never touched. The
# file's ownership, mode and capabilities are left as they are.
#
# The override is deliberately kept when the package is merely removed: it is the
# part of the policy that stops wireshark-common's postinst from creating a
# set-user-id dumpcap, so the no-setuid protection persists through a temporary
# removal of cham3-desktop. Until the package is installed again, a reinstalled
# or upgraded wireshark-common leaves dumpcap root-owned without capabilities
# (capture unavailable, never set-user-id). For the same reason an aborted first
# installation (abort-install, after the preinst registered the override) keeps
# it: the override can only make dumpcap less privileged.
set -e

dumpcap_default_path=/usr/bin/dumpcap
pin_listing_suffix="root root 750"

remove_dumpcap_override() {
    program=$(dpkg-divert --truename "${dumpcap_default_path}" 2> /dev/null) || program=${dumpcap_default_path}
    current_override=$(dpkg-statoverride --list "${program}" 2> /dev/null) || current_override=
    if [ "${current_override}" = "${pin_listing_suffix} ${program}" ]; then
        dpkg-statoverride --remove "${program}"
    fi
}

case "$1" in
    purge)
        remove_dumpcap_override
        ;;
    remove | upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

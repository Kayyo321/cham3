#!/bin/sh
# cham3-desktop postrm: drop the dpkg-statoverride that debian/postinst pins on
# /usr/bin/dumpcap, but only when it is exactly the one this package adds. An
# override set by the administrator is never touched. The file's ownership,
# mode and capabilities are left as they are.
set -e

dumpcap_default_path=/usr/bin/dumpcap
pin_listing_suffix="root root 754"

remove_dumpcap_override() {
    program=$(dpkg-divert --truename "${dumpcap_default_path}" 2> /dev/null) || program=${dumpcap_default_path}
    current_override=$(dpkg-statoverride --list "${program}" 2> /dev/null) || current_override=
    if [ "${current_override}" = "${pin_listing_suffix} ${program}" ]; then
        dpkg-statoverride --remove "${program}"
    fi
}

case "$1" in
    remove | purge)
        remove_dumpcap_override
        ;;
    upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
